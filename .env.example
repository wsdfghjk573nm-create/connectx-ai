# ConnectX AI — environment configuration (copy to .env and edit; .env is never committed)
# All values below are safe local-development defaults.

# Port the server listens on.
PORT=3000

# Secret used to sign JWT session tokens. CHANGE THIS in production.
JWT_SECRET=dev-only-change-me-in-production

# Path to the SQLite database file (created automatically).
DB_PATH=./data/connectx.db

# Directory where uploaded files (attachments, avatars) are stored on disk.
UPLOAD_DIR=./uploads

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=25

# Background sweep interval in ms (expired messages, due scheduled messages,
# temporary-group expiry). Lower it in tests if needed.
SWEEP_MS=1000

# --- Optional AI provider (OFF by default) -----------------------------------
# The built-in assistant is fully local and needs no key. If you set AI_API_KEY,
# the /api/ai/chat route will forward the *assistant conversation only* to an
# OpenAI-compatible endpoint. Private chats between users are NEVER sent.
# This route is provided for integration and is UNTESTED with a live key.
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini

# --- Email / SMS (NOT enabled in this build) --------------------------------
# Password-reset tokens are generated and returned in the API response while
# NODE_ENV is not "production" (dev mode) so the flow can be tested locally.
# Real email delivery needs an SMTP provider; SMS verification is not
# implemented in this version. Documented in README → "Honest limits".
# NODE_ENV=development
